class _AiChatSheet extends StatelessWidget {
  const _AiChatSheet({
    required this.scrollController,
    required this.messages,
    required this.controller,
    required this.isSending,
    required this.onSend,
  });

  final ScrollController scrollController;
  final List<_ChatMessage> messages;
  final TextEditingController controller;
  final bool isSending;
  final Future<void> Function(String) onSend;

  @override
  Widget build(BuildContext context) {
    final TextTheme textTheme = Theme.of(context).textTheme;
    const Color accent = Color(0xFFDB0011);

    return Material(
      color: const Color(0xFFF8F8F8),
      child: Padding(
        padding: const EdgeInsets.fromLTRB(16, 10, 16, 12),
        child: Column(
          children: <Widget>[
            Container(
              width: 40,
              height: 4,
              decoration: BoxDecoration(
                color: Colors.black26,
                borderRadius: BorderRadius.circular(100),
              ),
            ),
            const SizedBox(height: 12),
            Row(
              children: <Widget>[
                Text(
                  'AI Assistant',
                  style: textTheme.titleLarge?.copyWith(
                    fontWeight: FontWeight.w700,
                  ),
                ),
                const Spacer(),
                IconButton(
                  onPressed: () => Navigator.of(context).pop(),
                  icon: const Icon(Icons.close_rounded),
                ),
              ],
            ),
            const SizedBox(height: 8),
            Expanded(
              child: ListView.builder(
                controller: scrollController,
                itemCount: messages.length + (isSending ? 1 : 0),
                itemBuilder: (BuildContext context, int index) {
                  if (isSending && index == messages.length) {
                    return const Align(
                      alignment: Alignment.centerLeft,
                      child: Padding(
                        padding: EdgeInsets.symmetric(vertical: 8),
                        child: Row(
                          mainAxisSize: MainAxisSize.min,
                          children: <Widget>[
                            SizedBox(
                              width: 16,
                              height: 16,
                              child: CircularProgressIndicator(strokeWidth: 2),
                            ),
                            SizedBox(width: 8),
                            Text('Thinking...'),
                          ],
                        ),
                      ),
                    );
                  }
                  final _ChatMessage message = messages[index];
                  return Align(
                    alignment: message.isUser
                        ? Alignment.centerRight
                        : Alignment.centerLeft,
                    child: Container(
                      margin: const EdgeInsets.symmetric(vertical: 5),
                      padding: const EdgeInsets.symmetric(
                        horizontal: 13,
                        vertical: 10,
                      ),
                      constraints: const BoxConstraints(maxWidth: 290),
                      decoration: BoxDecoration(
                        color: message.isUser
                            ? const Color(0x1FDB0011)
                            : Colors.white,
                        borderRadius: BorderRadius.circular(14),
                        border: Border.all(
                          color: message.isUser
                              ? const Color(0x66DB0011)
                              : const Color(0xFFE8E8E8),
                        ),
                      ),
                      child: Text(
                        message.text,
                        style: textTheme.bodyMedium?.copyWith(
                          color: Colors.black87,
                        ),
                      ),
                    ),
                  );
                },
              ),
            ),
            const SizedBox(height: 8),
            Row(
              children: <Widget>[
                Expanded(
                  child: TextField(
                    controller: controller,
                    textInputAction: TextInputAction.send,
                    enabled: !isSending,
                    onSubmitted: (String value) {
                      unawaited(onSend(value));
                    },
                    decoration: InputDecoration(
                      hintText: isSending
                          ? 'Waiting for response...'
                          : 'Type your message...',
                      filled: true,
                      fillColor: Colors.white,
                      contentPadding: const EdgeInsets.symmetric(
                        horizontal: 14,
                        vertical: 12,
                      ),
                      border: OutlineInputBorder(
                        borderRadius: BorderRadius.circular(14),
                        borderSide: BorderSide.none,
                      ),
                    ),
                  ),
                ),
                const SizedBox(width: 10),
                FloatingActionButton.small(
                  onPressed: isSending
                      ? null
                      : () {
                          unawaited(onSend(controller.text));
                        },
                  backgroundColor: accent,
                  foregroundColor: Colors.white,
                  child: const Icon(Icons.send_rounded),
                ),
              ],
            ),
          ],
        ),
      ),
    );
  }
}

class _DeepSeekService {
  const _DeepSeekService();

  /// Ark OpenAI-compatible API base URL.
  ///
  /// You can override this at build time using `--dart-define=DEEPSEEK_BASE_URL=...`.
  static const String _baseUrl = String.fromEnvironment(
    'DEEPSEEK_BASE_URL',
    defaultValue: 'https://ark.cn-beijing.volces.com/api/v3',
  );

  /// DeepSeek API key.
  ///
  /// You can set it using `--dart-define=DEEPSEEK_API_KEY=your_key`.
  static const String _apiKey = String.fromEnvironment(
    'DEEPSEEK_API_KEY',
    defaultValue: '',
  );

  /// Model to use.
  ///
  /// You can override it at build time using `--dart-define=DEEPSEEK_MODEL=...`.
  static const String _model = String.fromEnvironment(
    'DEEPSEEK_MODEL',
    defaultValue: 'deepseek-v3-2-251201',
  );

  Future<String> chat({required List<_ChatMessage> messages}) async {
    if (_apiKey.isEmpty) {
      throw const _DeepSeekException(
        'Missing API key. Set --dart-define=DEEPSEEK_API_KEY=your_key.',
      );
    }

    final Uri uri = Uri.parse('$_baseUrl/chat/completions');
    final List<Map<String, String>> requestMessages = <Map<String, String>>[
      const <String, String>{
        'role': 'system',
        'content':
            'You are a bank app assistant. Keep answers concise, safe, and practical.',
      },
      ...messages
          .skip((messages.length - 12).clamp(0, messages.length))
          .map(
            (message) => <String, String>{
              'role': message.isUser ? 'user' : 'assistant',
              'content': message.text,
            },
          ),
    ];

    final http.Response response = await http
        .post(
          uri,
          headers: <String, String>{
            'Content-Type': 'application/json',
            'Authorization': 'Bearer $_apiKey',
          },
          body: jsonEncode(<String, dynamic>{
            'model': _model,
            'messages': requestMessages,
            'temperature': 0.7,
          }),
        )
        .timeout(const Duration(seconds: 30));

    if (response.statusCode < 200 || response.statusCode >= 300) {
      throw _DeepSeekException(
        'HTTP ${response.statusCode} ${_extractErrorMessage(response.body)}',
      );
    }

    final dynamic decoded = jsonDecode(response.body);
    final dynamic content = decoded['choices']?[0]?['message']?['content'];
    if (content is String && content.trim().isNotEmpty) {
      return content.trim();
    }
    throw const _DeepSeekException('No valid reply returned from model.');
  }

  String _extractErrorMessage(String body) {
    try {
      final dynamic decoded = jsonDecode(body);
      final dynamic error = decoded['error'];
      if (error is Map<String, dynamic>) {
        final dynamic message = error['message'];
        if (message is String && message.trim().isNotEmpty) {
          return message.trim();
        }
      }
    } catch (_) {
      // Ignore parse error and return short preview of body instead.
    }
    return body.length > 120 ? '${body.substring(0, 120)}...' : body;
  }
}

class _DeepSeekException implements Exception {
  const _DeepSeekException(this.message);

  final String message;
}

