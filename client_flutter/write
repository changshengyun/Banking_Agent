class _BankHomePageState extends State<BankHomePage> {
  final List<_ChatMessage> _messages = <_ChatMessage>[
    _ChatMessage(
      text: 'Hi, I am your AI assistant. Ask me anything about your account.',
      isUser: false,
    ),
  ];
  final TextEditingController _chatController = TextEditingController();
  final _DeepSeekService _deepSeekService = const _DeepSeekService();

  int _currentTab = 0;
  bool _isSending = false;

  final List<_QuickAction> _quickActions = const <_QuickAction>[
    _QuickAction(label: 'Transfer', icon: Icons.swap_horiz_rounded),
    _QuickAction(label: 'Savings', icon: Icons.savings_rounded),
    _QuickAction(label: 'Statement', icon: Icons.receipt_long_rounded),
  ];

  final List<_NavItem> _navItems = const <_NavItem>[
    _NavItem(label: 'Home', icon: Icons.home_rounded),
    _NavItem(label: 'Pay', icon: Icons.qr_code_2_rounded),
    _NavItem(label: 'Invest', icon: Icons.trending_up_rounded),
    _NavItem(label: 'Profile', icon: Icons.person_rounded),
  ];

  void _openAiAssistant() {
    showModalBottomSheet<void>(
      context: context,
      isScrollControlled: true,
      useSafeArea: true,
      shape: const RoundedRectangleBorder(
        borderRadius: BorderRadius.vertical(top: Radius.circular(26)),
      ),
      builder: (BuildContext context) {
        return DraggableScrollableSheet(
          initialChildSize: 0.58,
          minChildSize: 0.42,
          maxChildSize: 0.92,
          expand: false,
          builder: (BuildContext context, ScrollController scrollController) {
            return _AiChatSheet(
              scrollController: scrollController,
              messages: _messages,
              controller: _chatController,
              isSending: _isSending,
              onSend: _handleSendMessage,
            );
          },
        );
      },
    );
  }

  Future<void> _handleSendMessage(String text) async {
    final String content = text.trim();
    if (content.isEmpty || _isSending) return;

    setState(() {
      _isSending = true;
      _messages.add(_ChatMessage(text: content, isUser: true));
    });
    _chatController.clear();

    try {
      final String reply = await _deepSeekService.chat(messages: _messages);
      if (!mounted) return;
      setState(() {
        _messages.add(_ChatMessage(text: reply, isUser: false));
      });
    } on _DeepSeekException catch (e) {
      if (!mounted) return;
      setState(() {
        _messages.add(
          _ChatMessage(text: 'Request failed: ${e.message}', isUser: false),
        );
      });
    } catch (_) {
      if (!mounted) return;
      setState(() {
        _messages.add(
          _ChatMessage(
            text: 'Request failed: unexpected error.',
            isUser: false,
          ),
        );
      });
    } finally {
      if (mounted) {
        setState(() {
          _isSending = false;
        });
      }
    }
  }

  @override
  void dispose() {
    _chatController.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final ColorScheme scheme = Theme.of(context).colorScheme;
    final bool showFab = _currentTab == 0;

    return Scaffold(
      appBar: AppBar(
        title: const Text('Bank app demo'),
        centerTitle: false,
        backgroundColor: scheme.surface,
        foregroundColor: Colors.black87,
        elevation: 0,
      ),
      body: SafeArea(
        child: IndexedStack(
          index: _currentTab,
          children: <Widget>[
            _HomeTab(
              quickActions: _quickActions,
              onQuickActionTap: (String label) {
                ScaffoldMessenger.of(
                  context,
                ).showSnackBar(SnackBar(content: Text('Selected: $label')));
              },
            ),
            const _PlaceholderTab(
              title: 'Pay',
              hint: 'QR scan, payment code and collection features prototype',
            ),
            const _PlaceholderTab(
              title: 'Invest',
              hint: 'Fund, deposit and insurance service prototype',
            ),
            const _PlaceholderTab(
              title: 'Profile',
              hint: 'Account, settings and notification center prototype',
            ),
          ],
        ),
      ),
      floatingActionButton: showFab
          ? FloatingActionButton(
              onPressed: _openAiAssistant,
              backgroundColor: const Color(0xFFDB0011),
              foregroundColor: Colors.white,
              child: const Text(
                'AI',
                style: TextStyle(fontWeight: FontWeight.w700),
              ),
            )
          : null,
      bottomNavigationBar: NavigationBar(
        selectedIndex: _currentTab,
        onDestinationSelected: (int index) {
          setState(() {
            _currentTab = index;
          });
        },
        destinations: _navItems
            .map(
              (_NavItem item) => NavigationDestination(
                icon: Icon(item.icon),
                label: item.label,
              ),
            )
            .toList(),
      ),
    );
  }
